{
  "name": "eyesafer",
  "version": "1.0.0",
  "description": "Prevents eye strain through blink monitoring and visual micro-stimulation",
  "main": "out/main/index.js",
  "type": "module",
  "author": "EyeSafer",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:log": "electron-vite dev 2>&1 | tee logs/dev.log",
    "log": "node -e \"const fs=require('fs');const f='logs/dev.log';fs.existsSync(f)?process.stdout.write(fs.readFileSync(f)):console.log('No log file yet — run npm run dev:log first')\"",
    "electron:dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "preview": "electron-vite preview",
    "lint": "eslint src --ext .ts,.svelte",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.40.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.1",
    "@tailwindcss/forms": "^0.5.7",
    "@types/sql.js": "^1.4.9",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "autoprefixer": "^10.4.16",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "eslint": "^8.55.0",
    "eslint-plugin-svelte": "^2.35.1",
    "postcss": "^8.4.32",
    "svelte": "^4.2.8",
    "svelte-check": "^3.6.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.0.4"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@mediapipe/tasks-vision": "^0.10.8",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "electron-log": "^5.1.2",
    "electron-store": "^8.1.0",
    "sql.js": "^1.14.0",
    "svelte-preprocess": "^6.0.3"
  }
}
